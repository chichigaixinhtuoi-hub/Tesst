-- Gọi thư viện Orion Library
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/jensonhirst/Orion/main/source')))()

-- Tạo cửa sổ chính (Window)
local Window = OrionLib:MakeWindow({
    Name = "Undertale Rp Mess Timeline",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "UndertaleConfig"
})

-- Tạo Tab "Main"
local MainTab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

MainTab:AddLabel("By timelesstrue")

-- 0. FIX GAMEPLAY PAUSED (Chạy ngầm chống đứng hình khi tele xa / desync)
local RunService = game:GetService("RunService")
local antiPauseConnection = nil

MainTab:AddToggle({
    Name = "Fix Gameplay Paused (Anti-Lag/Desync)",
    Default = true,
    Callback = function(Value)
        if Value then
            if antiPauseConnection then antiPauseConnection:Disconnect() end
            antiPauseConnection = RunService.Stepped:Connect(function()
                pcall(function()
                    settings():GetService("RenderSettings").EagerBulkExecution = true
                    setfpscap(999)
                end)
            end)
            OrionLib:MakeNotification({ Name = "Anti-Pause Active", Content = "Đã bật chống đứng hình khi dịch chuyển xa!", Image = "rbxassetid://4483345998", Time = 3 })
        else
            if antiPauseConnection then antiPauseConnection:Disconnect() antiPauseConnection = nil end
            OrionLib:MakeNotification({ Name = "Anti-Pause Disabled", Content = "Đã tắt chống đứng hình.", Image = "rbxassetid://4483345998", Time = 3 })
        end
    end
})

-- Tự động chạy ngầm Anti-Pause để bảo vệ game ngay từ đầu
antiPauseConnection = RunService.Stepped:Connect(function()
    pcall(function()
        settings():GetService("RenderSettings").EagerBulkExecution = true
    end)
end)

-- 1. TỐI ƯU RENDER: Giới hạn phạm vi 400 studs (Mượt mà tuyệt đối khi đi xa)
local optimizeConnection = nil
MainTab:AddToggle({
    Name = "Optimize Render Range (400 Studs Radius)",
    Default = false,
    Callback = function(Value)
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        
        if Value then
            OrionLib:MakeNotification({ Name = "Optimizer Active", Content = "Đã bật giới hạn 400 studs!", Image = "rbxassetid://4483345998", Time = 3 })
            
            if optimizeConnection then optimizeConnection:Disconnect() end
            optimizeConnection = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local rootPos = char.HumanoidRootPart.Position
                
                for _, obj in ipairs(workspace:GetChildren()) do
                    if obj ~= char and obj:IsA("Model") and obj.PrimaryPart then
                        local distance = (obj.PrimaryPart.Position - rootPos).Magnitude
                        if distance > 400 then
                            if obj.Parent ~= nil then
                                for _, part in ipairs(obj:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part.LocalTransparencyModifier = 1
                                    end
                                end
                            end
                        else
                            for _, part in ipairs(obj:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.LocalTransparencyModifier = 0
                                end
                            end
                        end
                    end
                end
            end)
        else
            if optimizeConnection then optimizeConnection:Disconnect() optimizeConnection = nil end
            OrionLib:MakeNotification({ Name = "Optimizer Disabled", Content = "Đã tắt tối ưu phạm vi render.", Image = "rbxassetid://4483345998", Time = 3 })
        end
    end
})

-- 2. Nút xóa Character Box
MainTab:AddButton({
    Name = "Delete Character Box",
    Callback = function()
        local count = 0
        for _, v in ipairs(workspace:GetDescendants()) do
            if string.find(string.lower(v.Name), "box") then
                v:Destroy()
                count = count + 1
            end
        end
        OrionLib:MakeNotification({ Name = "Thành công!", Content = "Đã dọn dẹp và xóa " .. count .. " đối tượng.", Image = "rbxassetid://4483345998", Time = 5 })
    end
})

-- 3. GOD MODE & UNLOCK MOVEMENT (Bất tử nhẹ nhàng, chống khóa di chuyển trên không)
local godModeConnection = nil
local unlockMoveConnection = nil
local isGodModeActive = false

MainTab:AddToggle({
    Name = "God Mode & Unlock Movement",
    Default = false,
    Callback = function(Value)
        isGodModeActive = Value
        local player = game:GetService("Players").LocalPlayer
        
        if isGodModeActive then
            OrionLib:MakeNotification({ 
                Name = "God Mode Enabled", 
                Content = "Đã bật bất tử nhẹ nhàng & chống khóa di chuyển!", 
                Image = "rbxassetid://4483345998", 
                Time = 3 
            })
            
            local function setupGodMode(char)
                local humanoid = char:WaitForChild("Humanoid", 5)
                if humanoid then
                    if godModeConnection then godModeConnection:Disconnect() end
                    godModeConnection = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                        if isGodModeActive and humanoid.Health <= 0 then
                            humanoid.Health = humanoid.MaxHealth
                        end
                    end)
                end
                
                if unlockMoveConnection then unlockMoveConnection:Disconnect() end
                unlockMoveConnection = RunService.RenderStepped:Connect(function()
                    if not isGodModeActive then return end
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.PlatformStand = false
                        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                        if hum.WalkSpeed < 16 then
                            hum.WalkSpeed = 16
                        end
                    end
                end)
            end
            
            if player.Character then setupGodMode(player.Character) end
            player.CharacterAdded:Connect(setupGodMode)
            
        else
            if godModeConnection then godModeConnection:Disconnect() godModeConnection = nil end
            if unlockMoveConnection then unlockMoveConnection:Disconnect() unlockMoveConnection = nil end
            
            OrionLib:MakeNotification({ 
                Name = "God Mode Disabled", 
                Content = "Đã tắt chế độ God Mode.", 
                Image = "rbxassetid://4483345998", 
                Time = 3 
            })
        end
    end
})

-- Khởi động giao diện Orion
OrionLib:Init()
